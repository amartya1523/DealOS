{
  "name": "@dealos/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:fulfillment:pg": "node --import tsx tests/fulfillment.postgres.ts",
    "test:directory:pg": "node --import tsx tests/directory.postgres.ts",
    "test:portal-rfq:pg": "node --import tsx tests/portal-requests.postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
