generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Role {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  NEGOTIATION
  CONFIRMED
  REJECTED
}

enum ApprovalState {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum FulfillmentState {
  SPLIT_PENDING
  RESERVED
  PARTIAL
  FULFILLED
  BACKORDER
}

enum SubscriptionState {
  ACTIVE
  CANCELLED
}

enum InvoiceState {
  UNPAID
  PARTIAL
  PAID
}

enum AlertKind {
  STALLED
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  status       AccountStatus @default(PENDING)
  role         Role
  customerId   String?
  sessions     Session[]
  quotes       Quote[]   @relation("QuoteOwner")
  approvals    Approval[] @relation("ApprovalReviewer")
  auditEvents  AuditEvent[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(uuid())
  name        String
  sku         String      @unique
  category    String
  description String
  unit        String
  price       Decimal     @db.Decimal(12, 2)
  cost        Decimal     @db.Decimal(12, 2)
  taxRate     Decimal     @db.Decimal(5, 2)
  recurring   Boolean     @default(false)
  cadence     String?
  active      Boolean     @default(true)
  quoteLines  QuoteLine[]
  stocks      StockBalance[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model DiscountPolicy {
  id               String   @id @default(uuid())
  tier              String   @unique
  maxDiscount       Decimal  @db.Decimal(5, 2)
  hardwareLimit     Decimal  @db.Decimal(5, 2)
  servicesLimit     Decimal  @db.Decimal(5, 2)
  subscriptionLimit Decimal  @db.Decimal(5, 2)
  financeThreshold  Decimal  @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt
}

model Quote {
  id          String      @id @default(uuid())
  number      String      @unique
  customer    String
  customerTier String
  ownerId     String
  owner       User        @relation("QuoteOwner", fields: [ownerId], references: [id])
  stage       QuoteStage  @default(DRAFT)
  version     Int         @default(1)
  orderDiscount Decimal   @default(0) @db.Decimal(5, 2)
  total       Decimal     @default(0) @db.Decimal(14, 2)
  margin      Decimal     @default(0) @db.Decimal(14, 2)
  riskScore   Decimal     @default(0) @db.Decimal(8, 2)
  lastActivity DateTime   @default(now())
  lines       QuoteLine[]
  approvals   Approval[]
  fulfillment Fulfillment?
  invoices    Invoice[]
  negotiation Negotiation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  discount    Decimal  @db.Decimal(5, 2)
  allowedDiscount Decimal @default(0) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
}

model Approval {
  id          String        @id @default(uuid())
  quoteId     String
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  step        String
  sequence    Int
  state       ApprovalState @default(PENDING)
  reviewerId  String?
  reviewer    User?         @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  @@unique([quoteId, sequence])
}

model Warehouse {
  id          String         @id @default(uuid())
  name        String         @unique
  priority    Int
  shippingCost Decimal       @db.Decimal(12, 2)
  stocks      StockBalance[]
  createdAt   DateTime       @default(now())
}

model StockBalance {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  onHand      Int
  reserved    Int       @default(0)
  @@unique([warehouseId, productId])
}

model Fulfillment {
  id          String           @id @default(uuid())
  quoteId     String           @unique
  quote       Quote            @relation(fields: [quoteId], references: [id])
  state       FulfillmentState @default(SPLIT_PENDING)
  split       Json
  estimatedCost Decimal        @default(0) @db.Decimal(12, 2)
  shipmentCount Int            @default(0)
  updatedAt   DateTime         @updatedAt
}

model Subscription {
  id          String            @id @default(uuid())
  customer    String
  productName String
  cadence     String
  amount      Decimal           @db.Decimal(12, 2)
  nextBillAt  DateTime
  state       SubscriptionState @default(ACTIVE)
  createdAt   DateTime          @default(now())
}

model Invoice {
  id          String       @id @default(uuid())
  number      String       @unique
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id])
  customer    String
  amount      Decimal      @db.Decimal(14, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(14, 2)
  state       InvoiceState @default(UNPAID)
  dueAt       DateTime
  lines       Json
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  reference   String
  paidAt      DateTime
  createdAt   DateTime @default(now())
}

model Negotiation {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  author      String
  message     String
  counterDiscount Decimal? @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
}

model Alert {
  id          String    @id @default(uuid())
  kind        AlertKind
  title       String
  detail      String
  severity    String
  resourceId  String
  resolved    Boolean   @default(false)
  nudged      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String
  resource    String
  resourceId  String
  reason      String?
  createdAt   DateTime @default(now())
}
