generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Role {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum CustomerRepresentativeRole {
  PRIMARY
  COLLABORATOR
}

enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  NEGOTIATION
  CONFIRMED
  REJECTED
}

enum ApprovalState {
  WAITING
  PENDING
  APPROVED
  RETURNED
  REJECTED
  SUPERSEDED
}

enum ApprovalCaseState {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  SUPERSEDED
}

enum ApprovalRoute {
  NONE
  MANAGER
  MANAGER_FINANCE
}

enum RevisionState {
  DRAFT
  SUBMITTED
  SENT
  SUPERSEDED
}

enum ProposalKind {
  COMMENT
  PROPOSAL
}

enum ProposalState {
  OPEN
  ADOPTED
  DECLINED
}

enum OrderState {
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FulfillmentState {
  SPLIT_PENDING
  RESERVED
  PARTIAL
  FULFILLED
  BACKORDER
}

enum BackorderState {
  OPEN
  FULFILLED
}

enum StockMovementKind {
  RECEIPT
}

enum SubscriptionState {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionChangeKind {
  AMOUNT_CHANGED
  PAUSED
  RESUMED
  CANCELLED
}

enum InvoiceState {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
}

enum AlertKind {
  STALLED
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
  PORTAL_REQUEST
}

enum RfqHandlingMode {
  LEAD_FIRST
  DIRECT_DRAFT
}

enum PortalRequestStatus {
  NEW
  PROCESSED
  DISMISSED
}

enum LeadStatus {
  NEW
  CONVERTED
  DISMISSED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationAccessRole {
  ORGANIZATION_ADMIN
  ORGANIZATION_MEMBER
  PORTAL_USER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DirectoryJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id                       String                   @id @default(uuid())
  name                     String
  companyName              String?
  email                    String                   @unique
  loginId                  String?                  @unique
  googleSubject            String?                  @unique
  passwordHash             String
  status                   AccountStatus            @default(PENDING)
  role                     Role
  moduleAccess             String[]                 @default([])
  organizationId           String?
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  customerId               String?
  customer                 Customer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions                 Session[]
  quotes                   Quote[]                  @relation("QuoteOwner")
  quotesCreated            Quote[]                  @relation("QuoteCreator")
  managedSalesTeams        SalesTeam[]              @relation("SalesTeamManager")
  salesTeamMemberships     SalesTeamMember[]
  customerAssignments      CustomerRepresentative[] @relation("CustomerRepresentativeUser")
  customerAssignmentsMade  CustomerRepresentative[] @relation("CustomerRepresentativeAssigner")
  approvals                Approval[]               @relation("ApprovalReviewer")
  submittedApprovalCases   ApprovalCase[]           @relation("ApprovalCaseSubmitter")
  auditEvents              AuditEvent[]
  memberships              OrganizationMembership[]
  invitationsSent          OrganizationInvitation[] @relation("InvitationSender")
  privilegedActions        PrivilegedAudit[]        @relation("PrivilegedActor")
  simulatedActions         PrivilegedAudit[]        @relation("PrivilegedSimulatedUser")
  privilegedTargets        PrivilegedAudit[]        @relation("PrivilegedTargetUser")
  subscriptionChanges      SubscriptionChange[]
  invoiceNotes             InvoiceNote[]
  stockMovements           StockMovement[]
  portalRequestsSubmitted  PortalRequest[]          @relation("PortalRequestSubmitter")
  portalRequestsProcessed  PortalRequest[]          @relation("PortalRequestProcessor")
  assignedLeads            Lead[]                   @relation("LeadAssignedRep")
  requestAlerts            Alert[]                  @relation("AlertRecipient")
  directoryRequestsDecided DirectoryJoinRequest[]   @relation("DirectoryJoinRequestDecider")
  createdAt                DateTime                 @default(now())
}

model Organization {
  id                    String                   @id @default(uuid())
  name                  String
  slug                  String                   @unique
  status                OrganizationStatus       @default(ACTIVE)
  users                 User[]
  memberships           OrganizationMembership[]
  invitations           OrganizationInvitation[]
  customers             Customer[]
  products              Product[]
  policies              DiscountPolicy[]
  quotes                Quote[]
  salesTeams            SalesTeam[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  payments         Payment[]
  paymentWebhooks  PaymentWebhookEvent[]
  alerts                Alert[]
  portalRequests        PortalRequest[]
  leads                 Lead[]
  auditEvents           AuditEvent[]
  privilegedAudits      PrivilegedAudit[]
  directoryProfile      OrganizationProfile?
  directoryJoinRequests DirectoryJoinRequest[]
  rfqHandlingMode       RfqHandlingMode          @default(LEAD_FIRST)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model Customer {
  id                   String                   @id @default(uuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  tier                 String
  currency             String                   @default("INR")
  customerType         String                   @default("Business / Company")
  region               String                   @default("India")
  contactPerson        String?
  email                String?
  phone                String?
  countryCode          String                   @default("+91")
  gstin                String?
  billingAddress       String?
  shippingAddress      String?
  paymentTerms         Int                      @default(7)
  active               Boolean                  @default(true)
  primarySalesTeamId   String?
  primarySalesTeam     SalesTeam?               @relation(fields: [primarySalesTeamId], references: [id], onDelete: SetNull)
  assignmentVersion    Int                      @default(1)
  assignments          CustomerRepresentative[]
  users                User[]
  quotes               Quote[]
  orders               Order[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  invitations          OrganizationInvitation[]
  invoiceNotes         InvoiceNote[]
  portalRequests       PortalRequest[]
  leads                Lead[]
  directoryJoinRequest DirectoryJoinRequest?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, primarySalesTeamId])
}

model OrganizationProfile {
  organizationId   String       @id
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName      String
  shortDescription String?
  category         String?
  isDiscoverable   Boolean      @default(false)
  updatedAt        DateTime     @updatedAt
}

model DirectoryJoinRequest {
  id                  String                     @id @default(uuid())
  organizationId      String
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email               String
  companyName         String
  message             String
  contactName         String?
  marketplaceInterest Boolean                    @default(false)
  requestedProductId  String?
  requestedProduct    Product?                   @relation(fields: [requestedProductId], references: [id], onDelete: SetNull)
  requestedProductName String?
  requestedQuantity   Decimal?                   @db.Decimal(14, 3)
  portalPasswordHash  String?
  status              DirectoryJoinRequestStatus @default(PENDING)
  decidedById         String?
  decidedBy           User?                      @relation("DirectoryJoinRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt           DateTime?
  decisionReason      String?
  resultingCustomerId String?                    @unique
  resultingCustomer   Customer?                  @relation(fields: [resultingCustomerId], references: [id], onDelete: Restrict)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([organizationId, email, status])
  @@index([organizationId, status, createdAt])
  @@index([email, createdAt])
  @@index([requestedProductId])
}

model CustomerRepresentative {
  id           String                     @id @default(uuid())
  customerId   String
  customer     Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId       String
  user         User                       @relation("CustomerRepresentativeUser", fields: [userId], references: [id], onDelete: Restrict)
  role         CustomerRepresentativeRole
  assignedById String
  assignedBy   User                       @relation("CustomerRepresentativeAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt   DateTime                   @default(now())
  endedAt      DateTime?
  active       Boolean                    @default(true)

  @@index([userId, active])
  @@index([customerId, active])
}

model Session {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  csrfHash             String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  viewAsOrganizationId String?
  viewAsUserId         String?
  viewAsStartedAt      DateTime?
  activeOrganizationId String?
  createdAt            DateTime  @default(now())
}

model OrganizationMembership {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessRole     OrganizationAccessRole @default(ORGANIZATION_MEMBER)
  businessRole   Role
  status         MembershipStatus       @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model PlatformOwnerSession {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  csrfHash             String
  loginId              String
  expiresAt            DateTime
  viewAsOrganizationId String?
  viewAsUserId         String?
  viewAsStartedAt      DateTime?
  createdAt            DateTime  @default(now())

  @@index([expiresAt])
}

model OrganizationInvitation {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  customerId      String?
  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accessRole      OrganizationAccessRole
  businessRole    Role
  status          InvitationStatus       @default(PENDING)
  tokenHash       String                 @unique
  invitedById     String?
  invitedBy       User?                  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  platformActorId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime               @default(now())

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([customerId, status])
  @@index([organizationId, customerId, createdAt])
}

model Product {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  sku                String              @unique
  category           String
  description        String
  unit               String
  brand              String?
  price              Decimal             @db.Decimal(12, 2)
  cost               Decimal             @db.Decimal(12, 2)
  taxRate            Decimal             @db.Decimal(5, 2)
  recurring          Boolean             @default(false)
  cadence            String?
  active             Boolean             @default(true)
  storeVisible       Boolean             @default(true)
  featured           Boolean             @default(false)
  quoteLines         QuoteLine[]
  orderLines         OrderLine[]
  subscriptions      Subscription[]
  stocks             StockBalance[]
  backorders         Backorder[]
  stockMovements     StockMovement[]
  portalRequestLines PortalRequestLine[]
  directoryInterests DirectoryJoinRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model DiscountPolicy {
  id                     String         @id @default(uuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier                   String
  maxDiscount            Decimal        @db.Decimal(5, 2)
  hardwareLimit          Decimal        @db.Decimal(5, 2)
  servicesLimit          Decimal        @db.Decimal(5, 2)
  subscriptionLimit      Decimal        @db.Decimal(5, 2)
  financeThreshold       Decimal        @db.Decimal(5, 2)
  aggregateDiscountLimit Decimal        @default(20) @db.Decimal(5, 2)
  minimumMarginPercent   Decimal        @default(12) @db.Decimal(5, 2)
  version                Int            @default(1)
  publishedAt            DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  approvalCases          ApprovalCase[]

  @@unique([organizationId, tier])
}

model Quote {
  id                  String              @id @default(uuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number              String              @unique
  customer            String
  customerId          String
  customerRecord      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerTier        String
  ownerId             String
  owner               User                @relation("QuoteOwner", fields: [ownerId], references: [id])
  createdById         String
  createdBy           User                @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teamId              String?
  team                SalesTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stage               QuoteStage          @default(DRAFT)
  version             Int                 @default(1)
  orderDiscount       Decimal             @default(0) @db.Decimal(5, 2)
  total               Decimal             @default(0) @db.Decimal(14, 2)
  margin              Decimal             @default(0) @db.Decimal(14, 2)
  riskScore           Decimal             @default(0) @db.Decimal(8, 2)
  taxTotal            Decimal             @default(0) @db.Decimal(14, 2)
  totalsByCadence     Json                @default("{}")
  sentAt              DateTime?
  currentRevisionId   String?             @unique
  currentRevision     QuoteRevision?      @relation("CurrentQuoteRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  lastActivity        DateTime            @default(now())
  lines               QuoteLine[]
  approvals           Approval[]
  approvalCases       ApprovalCase[]
  fulfillment         Fulfillment?
  invoices            Invoice[]
  negotiation         Negotiation[]
  revisions           QuoteRevision[]     @relation("QuoteRevisions")
  acceptance          CustomerAcceptance?
  order               Order?
  sourcePortalRequest PortalRequest?      @relation("PortalRequestQuotation")
  convertedLead       Lead?               @relation("LeadQuotation")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([organizationId, stage, lastActivity, id])
  @@index([organizationId, ownerId, lastActivity, id])
  @@index([organizationId, teamId, lastActivity, id])
  @@index([createdById])
}

model SalesTeam {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  managerId        String?
  manager          User?             @relation("SalesTeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members          SalesTeamMember[]
  quotes           Quote[]
  primaryCustomers Customer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, managerId])
}

model SalesTeamMember {
  id        String    @id @default(uuid())
  teamId    String
  team      SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([teamId, userId])
  @@index([userId, teamId])
}

model QuoteRevision {
  id                 String              @id @default(uuid())
  quoteId            String
  quote              Quote               @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Restrict)
  currentFor         Quote?              @relation("CurrentQuoteRevision")
  revisionNumber     Int
  state              RevisionState       @default(DRAFT)
  currency           String              @default("INR")
  validUntil         DateTime?
  promisedDeliveryAt DateTime?
  terms              String?
  internalNote       String?
  orderDiscount      Decimal             @db.Decimal(5, 2)
  subtotal           Decimal             @db.Decimal(14, 2)
  taxTotal           Decimal             @db.Decimal(14, 2)
  total              Decimal             @db.Decimal(14, 2)
  margin             Decimal             @db.Decimal(14, 2)
  riskScore          Decimal             @db.Decimal(8, 2)
  totalsByCadence    Json
  linesSnapshot      Json
  policySnapshot     Json
  termsHash          String              @unique
  submittedById      String?
  sentAt             DateTime?
  approvals          Approval[]
  approvalCases      ApprovalCase[]
  negotiations       Negotiation[]
  acceptance         CustomerAcceptance?
  order              Order?
  createdAt          DateTime            @default(now())

  @@unique([quoteId, revisionNumber])
  @@index([quoteId, state])
}

model QuoteLine {
  id              String   @id @default(uuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  unitCost        Decimal  @db.Decimal(12, 2)
  discount        Decimal  @db.Decimal(5, 2)
  allowedDiscount Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
}

model Approval {
  id         String        @id @default(uuid())
  quoteId    String
  quote      Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId String
  revision   QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  caseId     String
  case       ApprovalCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  cycle      Int           @default(1)
  step       String
  sequence   Int
  state      ApprovalState @default(PENDING)
  reviewerId String?
  reviewer   User?         @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  reason     String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@unique([quoteId, cycle, sequence])
  @@unique([caseId, sequence])
  @@index([revisionId, state])
}

model ApprovalCase {
  id            String            @id @default(uuid())
  quoteId       String
  quote         Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionId    String
  revision      QuoteRevision     @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  policyId      String?
  policy        DiscountPolicy?   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  cycle         Int
  state         ApprovalCaseState @default(PENDING)
  route         ApprovalRoute
  version       Int               @default(1)
  riskSnapshot  Json
  submittedById String
  submittedBy   User              @relation("ApprovalCaseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  completedAt   DateTime?
  steps         Approval[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([quoteId, cycle])
  @@index([revisionId, state])
  @@index([state, createdAt])
}

model Warehouse {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  priority       Int
  shippingCost   Decimal        @db.Decimal(12, 2)
  active         Boolean        @default(true)
  stocks         StockBalance[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
}

model StockBalance {
  id            String          @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  onHand        Int
  reserved      Int             @default(0)
  minAlertLevel Int             @default(0)
  maxCapacity   Int?
  reservations  Reservation[]
  movements     StockMovement[]

  @@unique([warehouseId, productId])
}

model Fulfillment {
  id            String           @id @default(uuid())
  quoteId       String           @unique
  quote         Quote            @relation(fields: [quoteId], references: [id])
  orderId       String?          @unique
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  state         FulfillmentState @default(SPLIT_PENDING)
  split         Json
  estimatedCost Decimal          @default(0) @db.Decimal(12, 2)
  shipmentCount Int              @default(0)
  version       Int              @default(1)
  overridden    Boolean          @default(false)
  reason        String?
  reservations  Reservation[]
  backorders    Backorder[]
  updatedAt     DateTime         @updatedAt
}

model Reservation {
  id             String       @id @default(uuid())
  fulfillmentId  String
  fulfillment    Fulfillment  @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId    String
  orderLine      OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  stockBalanceId String
  stockBalance   StockBalance @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  quantity       Int
  source         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orderLineId, stockBalanceId])
  @@index([orderId, createdAt])
  @@index([stockBalanceId])
}

model Backorder {
  id                String         @id @default(uuid())
  fulfillmentId     String
  fulfillment       Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId       String         @unique
  orderLine         OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName       String
  originalQuantity  Int
  remainingQuantity Int
  state             BackorderState @default(OPEN)
  fulfilledAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId, state])
  @@index([productId, state])
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockBalanceId String
  stockBalance   StockBalance      @relation(fields: [stockBalanceId], references: [id], onDelete: Restrict)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind           StockMovementKind
  quantityDelta  Int
  reference      String?
  reason         String
  actorId        String
  actor          User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([stockBalanceId, createdAt])
  @@index([orderId, createdAt])
}

model Subscription {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       String
  customerId     String?
  customerRecord Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId        String?
  orderId        String?
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId    String?              @unique
  orderLine      OrderLine?           @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  cadence        String
  amount         Decimal              @db.Decimal(12, 2)
  nextBillAt     DateTime
  state          SubscriptionState    @default(ACTIVE)
  version        Int                  @default(1)
  cancelledAt    DateTime?
  changes        SubscriptionChange[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model SubscriptionChange {
  id             String                 @id @default(uuid())
  subscriptionId String
  subscription   Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  actorId        String
  actor          User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind           SubscriptionChangeKind
  previousAmount Decimal?               @db.Decimal(12, 2)
  newAmount      Decimal?               @db.Decimal(12, 2)
  previousState  SubscriptionState
  newState       SubscriptionState
  effectiveAt    DateTime
  reason         String
  createdAt      DateTime               @default(now())

  @@index([subscriptionId, createdAt])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String        @unique
  billingKey     String?       @unique
  quoteId        String
  quote          Quote         @relation(fields: [quoteId], references: [id])
  customer       String
  customerId     String
  customerRecord Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currency       String        @default("INR")
  amount         Decimal       @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  state          InvoiceState  @default(UNPAID)
  dueAt          DateTime
  lines          Json
  version        Int           @default(1)
  payments       Payment[]
  notes          InvoiceNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InvoiceNote {
  id             String    @id @default(uuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  kind           String
  message        String
  requestedDueAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([invoiceId, createdAt])
}

model Payment {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId          String
  invoice            Invoice       @relation(fields: [invoiceId], references: [id])
  amount             Decimal       @db.Decimal(14, 2)
  currency           String        @default("INR")
  reference          String
  provider           String        @default("MANUAL")
  status             PaymentStatus @default(SUCCESS)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  failureCode        String?
  failureDescription String?
  verifiedAt         DateTime?
  paidAt             DateTime?
  reversalOfId       String?       @unique
  reversal           Payment?      @relation("PaymentReversal")
  reversalOf         Payment?      @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reason             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([invoiceId, reference])
  @@index([organizationId, invoiceId, status])
}

model PaymentWebhookEvent {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventKey       String        @unique
  eventType      String
  payloadHash    String
  processedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model Negotiation {
  id                  String        @id @default(uuid())
  quoteId             String
  quote               Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId          String
  revision            QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  kind                ProposalKind  @default(COMMENT)
  state               ProposalState @default(OPEN)
  author              String
  message             String
  messageType         String        @default("COMMENT")
  counterDiscount     Decimal?      @db.Decimal(5, 2)
  requestedDeliveryAt DateTime?
  respondedById       String?
  responseReason      String?
  respondedAt         DateTime?
  adoptedRevisionId   String?
  createdAt           DateTime      @default(now())

  @@index([quoteId, revisionId, kind, state])
}

model CustomerAcceptance {
  id           String        @id @default(uuid())
  quoteId      String        @unique
  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionId   String        @unique
  revision     QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  customerId   String
  acceptedById String
  termsHash    String
  acceptedAt   DateTime      @default(now())
  order        Order?
}

model Order {
  id             String             @id @default(uuid())
  number         String             @unique
  quoteId        String             @unique
  quote          Quote              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionId     String             @unique
  revision       QuoteRevision      @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  acceptanceId   String             @unique
  acceptance     CustomerAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  state          OrderState         @default(CONFIRMED)
  currency       String             @default("INR")
  lines          OrderLine[]
  fulfillment    Fulfillment?
  reservations   Reservation[]
  backorders     Backorder[]
  stockMovements StockMovement[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model OrderLine {
  id           String        @id @default(uuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quoteLineId  String        @unique
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  snapshot     Json
  recurring    Boolean
  cadence      String?
  subscription Subscription?
  reservations Reservation[]
  backorder    Backorder?
  createdAt    DateTime      @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  actorId        String
  operation      String
  resourceKey    String
  key            String
  payloadHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([actorId, operation, resourceKey, key])
  @@index([createdAt])
}

model Alert {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind             AlertKind
  title            String
  detail           String
  severity         String
  resourceId       String
  resourceType     String       @default("QUOTE")
  recipientId      String?
  recipient        User?        @relation("AlertRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  evaluationKey    String?      @unique
  resolved         Boolean      @default(false)
  nudged           Boolean      @default(false)
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  lastEvaluatedAt  DateTime?
  createdAt        DateTime     @default(now())

  @@index([organizationId, resolved, kind])
  @@index([recipientId, resolved, createdAt])
}

model PortalRequest {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  submittedByUserId     String
  submittedBy           User                @relation("PortalRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  requirementsText      String
  preferredDeliveryDate DateTime?
  status                PortalRequestStatus @default(NEW)
  resultingLeadId       String?             @unique
  resultingLead         Lead?               @relation("PortalRequestResultingLead", fields: [resultingLeadId], references: [id], onDelete: SetNull)
  resultingQuotationId  String?             @unique
  resultingQuotation    Quote?              @relation("PortalRequestQuotation", fields: [resultingQuotationId], references: [id], onDelete: SetNull)
  processedAt           DateTime?
  processedById         String?
  processedBy           User?               @relation("PortalRequestProcessor", fields: [processedById], references: [id], onDelete: Restrict)
  lines                 PortalRequestLine[]
  lead                  Lead?               @relation("LeadSourceRequest")
  createdAt             DateTime            @default(now())

  @@index([organizationId, customerId, createdAt])
  @@index([submittedByUserId, createdAt])
}

model PortalRequestLine {
  id                  String        @id @default(uuid())
  portalRequestId     String
  portalRequest       PortalRequest @relation(fields: [portalRequestId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  freeTextDescription String?
  quantity            Decimal?      @db.Decimal(14, 3)
  degraded            Boolean       @default(false)
  degradedReason      String?

  @@index([portalRequestId])
  @@index([productId])
}

model Lead {
  id                   String         @id @default(uuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  portalRequestId      String         @unique
  portalRequest        PortalRequest  @relation("LeadSourceRequest", fields: [portalRequestId], references: [id], onDelete: Cascade)
  resultForRequest     PortalRequest? @relation("PortalRequestResultingLead")
  assignedRepId        String
  assignedRep          User           @relation("LeadAssignedRep", fields: [assignedRepId], references: [id], onDelete: Restrict)
  status               LeadStatus     @default(NEW)
  requirementsSummary  String
  convertedQuotationId String?        @unique
  convertedQuotation   Quote?         @relation("LeadQuotation", fields: [convertedQuotationId], references: [id], onDelete: SetNull)
  dismissReason        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([organizationId, assignedRepId, status, createdAt])
  @@index([customerId, status])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String
  resource       String
  resourceId     String
  reason         String?
  revisionId     String?
  requestId      String?
  createdAt      DateTime     @default(now())
}

model PrivilegedAudit {
  id              String        @id @default(uuid())
  actorId         String?
  actor           User?         @relation("PrivilegedActor", fields: [actorId], references: [id], onDelete: Restrict)
  platformActorId String?
  simulatedUserId String?
  simulatedUser   User?         @relation("PrivilegedSimulatedUser", fields: [simulatedUserId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId    String?
  targetUser      User?         @relation("PrivilegedTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action          String
  affectedModel   String
  recordId        String?
  beforeValues    Json?
  afterValues     Json?
  reason          String
  requestId       String
  ipAddress       String?
  userAgent       String?
  result          String
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([platformActorId, createdAt])
}
