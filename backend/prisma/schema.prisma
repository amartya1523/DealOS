generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Role {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  NEGOTIATION
  CONFIRMED
  REJECTED
}

enum ApprovalState {
  WAITING
  PENDING
  APPROVED
  RETURNED
  REJECTED
  SUPERSEDED
}

enum RevisionState {
  DRAFT
  SUBMITTED
  SENT
  SUPERSEDED
}

enum ProposalKind {
  COMMENT
  PROPOSAL
}

enum ProposalState {
  OPEN
  ADOPTED
  DECLINED
}

enum OrderState {
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FulfillmentState {
  SPLIT_PENDING
  RESERVED
  PARTIAL
  FULFILLED
  BACKORDER
}

enum SubscriptionState {
  ACTIVE
  CANCELLED
}

enum InvoiceState {
  UNPAID
  PARTIAL
  PAID
}

enum AlertKind {
  STALLED
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationAccessRole {
  ORGANIZATION_ADMIN
  ORGANIZATION_MEMBER
  PORTAL_USER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id                String                   @id @default(uuid())
  name              String
  email             String                   @unique
  loginId           String?                  @unique
  googleSubject     String?                  @unique
  passwordHash      String
  status            AccountStatus            @default(PENDING)
  role              Role
  moduleAccess      String[]                 @default([])
  organizationId    String?
  organization      Organization?            @relation(fields: [organizationId], references: [id])
  customerId        String?
  customer          Customer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions          Session[]
  quotes            Quote[]                  @relation("QuoteOwner")
  managedSalesTeams SalesTeam[]              @relation("SalesTeamManager")
  salesTeamMemberships SalesTeamMember[]
  approvals         Approval[]               @relation("ApprovalReviewer")
  auditEvents       AuditEvent[]
  memberships       OrganizationMembership[]
  invitationsSent   OrganizationInvitation[] @relation("InvitationSender")
  privilegedActions PrivilegedAudit[]        @relation("PrivilegedActor")
  simulatedActions  PrivilegedAudit[]        @relation("PrivilegedSimulatedUser")
  privilegedTargets PrivilegedAudit[]        @relation("PrivilegedTargetUser")
  createdAt         DateTime                 @default(now())
}

model Organization {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  status           OrganizationStatus       @default(ACTIVE)
  users            User[]
  memberships      OrganizationMembership[]
  invitations      OrganizationInvitation[]
  customers        Customer[]
  products         Product[]
  policies         DiscountPolicy[]
  quotes           Quote[]
  salesTeams       SalesTeam[]
  warehouses       Warehouse[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  alerts           Alert[]
  auditEvents      AuditEvent[]
  privilegedAudits PrivilegedAudit[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  tier           String
  currency       String         @default("INR")
  customerType   String         @default("Business / Company")
  region         String         @default("India")
  contactPerson  String?
  email          String?
  phone          String?
  countryCode    String         @default("+91")
  gstin          String?
  billingAddress String?
  shippingAddress String?
  paymentTerms   Int            @default(7)
  active         Boolean        @default(true)
  users          User[]
  quotes         Quote[]
  orders         Order[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  invitations    OrganizationInvitation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, name])
}

model Session {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  csrfHash             String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  viewAsOrganizationId String?
  viewAsUserId         String?
  viewAsStartedAt      DateTime?
  createdAt            DateTime  @default(now())
}

model OrganizationMembership {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessRole     OrganizationAccessRole @default(ORGANIZATION_MEMBER)
  businessRole   Role
  status         MembershipStatus       @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model PlatformOwnerSession {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  csrfHash             String
  loginId              String
  expiresAt            DateTime
  viewAsOrganizationId String?
  viewAsUserId         String?
  viewAsStartedAt      DateTime?
  createdAt            DateTime  @default(now())

  @@index([expiresAt])
}

model OrganizationInvitation {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  customerId      String?
  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accessRole      OrganizationAccessRole
  businessRole    Role
  status          InvitationStatus       @default(PENDING)
  tokenHash       String                 @unique
  invitedById     String?
  invitedBy       User?                  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  platformActorId String?
  expiresAt       DateTime
  createdAt       DateTime               @default(now())

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([customerId, status])
}

model Product {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String         @unique
  category       String
  description    String
  unit           String
  price          Decimal        @db.Decimal(12, 2)
  cost           Decimal        @db.Decimal(12, 2)
  taxRate        Decimal        @db.Decimal(5, 2)
  recurring      Boolean        @default(false)
  cadence        String?
  active         Boolean        @default(true)
  storeVisible   Boolean        @default(true)
  featured       Boolean        @default(false)
  quoteLines     QuoteLine[]
  orderLines     OrderLine[]
  subscriptions  Subscription[]
  stocks         StockBalance[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DiscountPolicy {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier              String
  maxDiscount       Decimal      @db.Decimal(5, 2)
  hardwareLimit     Decimal      @db.Decimal(5, 2)
  servicesLimit     Decimal      @db.Decimal(5, 2)
  subscriptionLimit Decimal      @db.Decimal(5, 2)
  financeThreshold  Decimal      @db.Decimal(5, 2)
  version           Int          @default(1)
  publishedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, tier])
}

model Quote {
  id                String              @id @default(uuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number            String              @unique
  customer          String
  customerId        String
  customerRecord    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerTier      String
  ownerId           String
  owner             User                @relation("QuoteOwner", fields: [ownerId], references: [id])
  teamId            String?
  team              SalesTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stage             QuoteStage          @default(DRAFT)
  version           Int                 @default(1)
  orderDiscount     Decimal             @default(0) @db.Decimal(5, 2)
  total             Decimal             @default(0) @db.Decimal(14, 2)
  margin            Decimal             @default(0) @db.Decimal(14, 2)
  riskScore         Decimal             @default(0) @db.Decimal(8, 2)
  taxTotal          Decimal             @default(0) @db.Decimal(14, 2)
  totalsByCadence   Json                @default("{}")
  sentAt            DateTime?
  currentRevisionId String?             @unique
  currentRevision   QuoteRevision?      @relation("CurrentQuoteRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  lastActivity      DateTime            @default(now())
  lines             QuoteLine[]
  approvals         Approval[]
  fulfillment       Fulfillment?
  invoices          Invoice[]
  negotiation       Negotiation[]
  revisions         QuoteRevision[]     @relation("QuoteRevisions")
  acceptance        CustomerAcceptance?
  order             Order?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, stage, lastActivity, id])
  @@index([organizationId, ownerId, lastActivity, id])
  @@index([organizationId, teamId, lastActivity, id])
}

model SalesTeam {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  managerId      String?
  manager        User?             @relation("SalesTeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members        SalesTeamMember[]
  quotes         Quote[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, managerId])
}

model SalesTeamMember {
  id        String    @id @default(uuid())
  teamId    String
  team      SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([teamId, userId])
  @@index([userId, teamId])
}

model QuoteRevision {
  id              String              @id @default(uuid())
  quoteId         String
  quote           Quote               @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Restrict)
  currentFor      Quote?              @relation("CurrentQuoteRevision")
  revisionNumber  Int
  state           RevisionState       @default(DRAFT)
  currency        String              @default("INR")
  validUntil      DateTime?
  promisedDeliveryAt DateTime?
  terms           String?
  orderDiscount   Decimal             @db.Decimal(5, 2)
  subtotal        Decimal             @db.Decimal(14, 2)
  taxTotal        Decimal             @db.Decimal(14, 2)
  total           Decimal             @db.Decimal(14, 2)
  margin          Decimal             @db.Decimal(14, 2)
  riskScore       Decimal             @db.Decimal(8, 2)
  totalsByCadence Json
  linesSnapshot   Json
  policySnapshot  Json
  termsHash       String              @unique
  submittedById   String?
  sentAt          DateTime?
  approvals       Approval[]
  negotiations    Negotiation[]
  acceptance      CustomerAcceptance?
  order           Order?
  createdAt       DateTime            @default(now())

  @@unique([quoteId, revisionNumber])
  @@index([quoteId, state])
}

model QuoteLine {
  id              String   @id @default(uuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  unitCost        Decimal  @db.Decimal(12, 2)
  discount        Decimal  @db.Decimal(5, 2)
  allowedDiscount Decimal  @default(0) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
}

model Approval {
  id         String        @id @default(uuid())
  quoteId    String
  quote      Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId String
  revision   QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  cycle      Int           @default(1)
  step       String
  sequence   Int
  state      ApprovalState @default(PENDING)
  reviewerId String?
  reviewer   User?         @relation("ApprovalReviewer", fields: [reviewerId], references: [id])
  reason     String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@unique([quoteId, cycle, sequence])
  @@index([revisionId, state])
}

model Warehouse {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  priority       Int
  shippingCost   Decimal        @db.Decimal(12, 2)
  stocks         StockBalance[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
}

model StockBalance {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  onHand      Int
  reserved    Int       @default(0)
  minAlertLevel Int      @default(0)
  maxCapacity   Int?

  @@unique([warehouseId, productId])
}

model Fulfillment {
  id            String           @id @default(uuid())
  quoteId       String           @unique
  quote         Quote            @relation(fields: [quoteId], references: [id])
  orderId       String?          @unique
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  state         FulfillmentState @default(SPLIT_PENDING)
  split         Json
  estimatedCost Decimal          @default(0) @db.Decimal(12, 2)
  shipmentCount Int              @default(0)
  updatedAt     DateTime         @updatedAt
}

model Subscription {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       String
  customerId     String?
  customerRecord Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId        String?
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId    String?           @unique
  orderLine      OrderLine?        @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  cadence        String
  amount         Decimal           @db.Decimal(12, 2)
  nextBillAt     DateTime
  state          SubscriptionState @default(ACTIVE)
  createdAt      DateTime          @default(now())
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique
  quoteId        String
  quote          Quote        @relation(fields: [quoteId], references: [id])
  customer       String
  customerId     String
  customerRecord Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(14, 2)
  paidAmount     Decimal      @default(0) @db.Decimal(14, 2)
  state          InvoiceState @default(UNPAID)
  dueAt          DateTime
  lines          Json
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  reference String
  paidAt    DateTime
  createdAt DateTime @default(now())

  @@unique([invoiceId, reference])
}

model Negotiation {
  id              String        @id @default(uuid())
  quoteId         String
  quote           Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revisionId      String
  revision        QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  kind            ProposalKind  @default(COMMENT)
  state           ProposalState @default(OPEN)
  author          String
  message         String
  counterDiscount Decimal?      @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())
}

model CustomerAcceptance {
  id           String        @id @default(uuid())
  quoteId      String        @unique
  quote        Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionId   String        @unique
  revision     QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  customerId   String
  acceptedById String
  termsHash    String
  acceptedAt   DateTime      @default(now())
  order        Order?
}

model Order {
  id            String             @id @default(uuid())
  number        String             @unique
  quoteId       String             @unique
  quote         Quote              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  revisionId    String             @unique
  revision      QuoteRevision      @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  acceptanceId  String             @unique
  acceptance    CustomerAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  state         OrderState         @default(CONFIRMED)
  currency      String             @default("INR")
  lines         OrderLine[]
  fulfillment   Fulfillment?
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model OrderLine {
  id           String        @id @default(uuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quoteLineId  String        @unique
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  snapshot     Json
  recurring    Boolean
  cadence      String?
  subscription Subscription?
  createdAt    DateTime      @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  actorId        String
  operation      String
  resourceKey    String
  key            String
  payloadHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([actorId, operation, resourceKey, key])
  @@index([createdAt])
}

model Alert {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           AlertKind
  title          String
  detail         String
  severity       String
  resourceId     String
  resolved       Boolean      @default(false)
  nudged         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String
  resource       String
  resourceId     String
  reason         String?
  revisionId     String?
  requestId      String?
  createdAt      DateTime     @default(now())
}

model PrivilegedAudit {
  id              String        @id @default(uuid())
  actorId         String?
  actor           User?         @relation("PrivilegedActor", fields: [actorId], references: [id], onDelete: Restrict)
  platformActorId String?
  simulatedUserId String?
  simulatedUser   User?         @relation("PrivilegedSimulatedUser", fields: [simulatedUserId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetUserId    String?
  targetUser      User?         @relation("PrivilegedTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action          String
  affectedModel   String
  recordId        String?
  beforeValues    Json?
  afterValues     Json?
  reason          String
  requestId       String
  ipAddress       String?
  userAgent       String?
  result          String
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([platformActorId, createdAt])
}
